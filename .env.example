# Server-only Neon PostgreSQL settings; never use NEXT_PUBLIC_ prefixes.
# Runtime: restricted SQL-created role + pooled endpoint (-pooler hostname).
DATABASE_URL="postgresql://form_studio_runtime:URL_ENCODED_RUNTIME_PASSWORD@ep-your-project-pooler.REGION.aws.neon.tech:5432/neondb?sslmode=verify-full"
# Migration owner: direct endpoint (no -pooler). Keep this out of deployed runtime env.
DIRECT_URL="postgresql://neondb_owner:URL_ENCODED_OWNER_PASSWORD@ep-your-project.REGION.aws.neon.tech:5432/neondb?sslmode=verify-full"
# Generate locally: openssl rand -hex 32. Same value on every deployed instance.
SHARE_RATE_LIMIT_SECRET="replace-with-at-least-32-random-characters"

# Vercel daily cleanup authentication. Generate a separate 32-byte secret.
CRON_SECRET="replace-with-a-separate-random-cleanup-secret"
