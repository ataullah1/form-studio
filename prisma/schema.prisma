generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}
model SharedConfiguration {
  publicId String @id @map("public_id") @db.VarChar(32)
  idempotencyKey String @unique @map("idempotency_key") @db.Uuid
  ownerUserId String? @map("owner_user_id") @db.VarChar(255)
  fingerprint String @db.Char(64)
  configuration Json
  schemaVersion Int @map("schema_version")
  catalogVersion String @map("catalog_version") @db.VarChar(32)
  estimatedTotalCents Int @map("estimated_total_cents")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([ownerUserId,createdAt(sort: Desc),publicId], map: "shared_configurations_owner_idx")
  @@map("shared_configurations")
  @@schema("app")
}
model RateBucket {
  key String @id @db.VarChar(80)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count Int
  @@map("rate_buckets")
  @@schema("app")
}

model QuoteRequest {
  id String @id @db.Uuid
  reference String @unique @db.VarChar(32)
  idempotencyKey String @unique @map("idempotency_key") @db.Uuid
  ownerUserId String? @map("owner_user_id") @db.VarChar(255)
  fingerprint String @db.Char(64)
  configuration Json
  catalogVersion String @map("catalog_version") @db.VarChar(32)
  estimatedTotalCents Int @map("estimated_total_cents")
  sourcePublicId String? @map("source_public_id") @db.VarChar(32)
  status String @default("NEW") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  statusVersion Int @default(0) @map("status_version")
  history QuoteStatusHistory[]
  contact QuoteContact?
  @@index([status,createdAt(sort: Desc),id], map: "quote_requests_inbox_idx")
  @@index([ownerUserId,createdAt(sort: Desc),id], map: "quote_requests_owner_idx")
  @@map("quote_requests")
  @@schema("app")
}
model QuoteContact {
  quoteId String @id @map("quote_id") @db.Uuid
  name String @db.VarChar(100)
  email String @db.VarChar(254)
  company String @db.VarChar(120)
  country String @db.VarChar(100)
  message String @db.VarChar(1000)
  expiresAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + '5 days'::interval)")) @map("expires_at") @db.Timestamptz(3)
  quote QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("quote_contacts")
  @@schema("app")
}

model AdminSession {
  tokenHash String @id @map("token_hash") @db.Char(64)
  userId String @map("user_id") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("admin_sessions")
  @@schema("app")
}
model AdminLoginFlow {
  destination String @default("/admin/quotes") @db.VarChar(32)
  stateHash String @id @map("state_hash") @db.Char(64)
  bindingHash String @map("binding_hash") @db.Char(64)
  verifier String @db.VarChar(128)
  nonce String @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("admin_login_flows")
  @@schema("app")
}
model QuoteStatusHistory {
  id String @id @db.Uuid
  quoteId String @map("quote_id") @db.Uuid
  actorId String @map("actor_id") @db.VarChar(255)
  fromStatus String @map("from_status") @db.VarChar(16)
  toStatus String @map("to_status") @db.VarChar(16)
  version Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  quote QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([quoteId,version])
  @@map("quote_status_history")
  @@schema("app")
}
